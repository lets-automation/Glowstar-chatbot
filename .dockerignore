# Never bake secrets or local state into an image layer.
.env
.env.*
!.env.docker.example

# Local dev artifacts - irrelevant or huge inside a container.
# NOTE the leading-dot variants: a plain "venv/" does NOT match ".venv/" or
# ".auditvenv/", so those were being sent to the daemon AND copied into the
# image by "COPY . ." - ~300 MB of Windows-only files that cannot run on the
# Linux base image anyway.
venv/
.venv/
.auditvenv/
*venv/
node_modules/
frontend/dist/
frontend/node_modules/
__pycache__/
*.pyc
.pytest_cache/
outputs/
logs/
.git/
.gitignore

# NEVER bake the operator's data/backups or generated reports into the image
# ("COPY . ." would otherwise ship the real AasthaErp backup + exports).
db_backup/
backups/
artifacts/
*.bak
*.mdf
*.ldf
*.dump
*.xlsx
*.pdf
tests/

# Internal notes and client material - nothing here is needed at runtime, and
# docs/ holds the meeting notes, the commercial proposal and a full dictionary
# of the real database.
docs/
*.md

# Editor/OS cruft
.vscode/
.idea/
*.swp
.DS_Store
