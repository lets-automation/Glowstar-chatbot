# Python
venv/
.venv/
.auditvenv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
frontend/dist/

# Secrets - NEVER commit this
.env
.env.*
!.env.docker.example

# Logs and generated outputs
logs/
outputs/

# Generated exports (report.xlsx, packet.xlsx, ...) - rebuilt on demand.
# Leading slash: root-level only, so app/artifacts/ source code is untouched.
/artifacts/

# Operator data - real AasthaErp backups and chat-history dumps.
# backups/history keeps its own .gitignore: it is a compose bind-mount, so the
# directory must survive a clone even though every *.dump in it is ignored.
db_backup/*
!db_backup/.gitkeep
*.dump
*.bak
*.mdf
*.ldf

# Docs: internal working notes, client material and generated dictionaries live
# in /docs and stay local. Only the READMEs are published. The whole folder is
# ignored, so anything dropped in there is private by default - including the
# question bank scripts/retest.py and scripts/run_test_suite.py read.


#
# THE RULES BELOW WERE MISSING. The comment above described the intent and
# nothing implemented it: `git check-ignore docs/HANDOFF.md` matched nothing
# and the !README negations were dangling with no ignore to negate. A plain
# `git add .` would have committed the whole folder - the same client
# material that had to be purged from history on 2026-08-05. Found
# 2026-09-03 while writing docs/HANDOFF.md.
docs/
*.md

!README.md
!frontend/README.md

# Editor
.vscode/
.idea/
.claude/
*.swp

# OS
Thumbs.db
.DS_Store
